{
  "name": "@jbcom/lifecycle-kit",
  "version": "0.1.0",
  "description": "The stage stack: chemistry, biological scaling laws, compositional form, pigment, and 2.5D assembly.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./chem": {
      "types": "./dist/esm/chem/index.d.ts",
      "import": "./dist/esm/chem/index.js"
    },
    "./forms": {
      "types": "./dist/esm/forms/index.d.ts",
      "import": "./dist/esm/forms/index.js"
    },
    "./bio-laws": {
      "types": "./dist/esm/bio-laws/index.d.ts",
      "import": "./dist/esm/bio-laws/index.js"
    },
    "./pigment": {
      "types": "./dist/esm/pigment/index.d.ts",
      "import": "./dist/esm/pigment/index.js"
    },
    "./assemblage": {
      "types": "./dist/esm/assemblage/index.d.ts",
      "import": "./dist/esm/assemblage/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/lifecycle-kit.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/lifecycle-kit/issues"
  },
  "homepage": "https://github.com/jbcom/lifecycle-kit#readme",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "keywords": [
    "procedural-generation",
    "chemistry",
    "biology",
    "compositional-form",
    "pigment",
    "2.5d",
    "game-dev"
  ]
}
