{
  "name": "@jbdevprimary/lifecycle-kit",
  "version": "0.1.0",
  "description": "The stage stack: chemistry, biological scaling laws, compositional form, pigment, and 2.5D assembly.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./chem": {
      "types": "./dist/esm/chem/index.d.ts",
      "import": "./dist/esm/chem/index.js"
    },
    "./forms": {
      "types": "./dist/esm/forms/index.d.ts",
      "import": "./dist/esm/forms/index.js"
    },
    "./bio-laws": {
      "types": "./dist/esm/bio-laws/index.d.ts",
      "import": "./dist/esm/bio-laws/index.js"
    },
    "./pigment": {
      "types": "./dist/esm/pigment/index.d.ts",
      "import": "./dist/esm/pigment/index.js"
    },
    "./assemblage": {
      "types": "./dist/esm/assemblage/index.d.ts",
      "import": "./dist/esm/assemblage/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/__tests__/**",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "check:examples": "node examples/quick-start.mjs && node examples/world-creature.mjs",
    "check:package": "publint && attw --pack . --profile esm-only",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run check:examples && pnpm run check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.10",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.23.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/lifecycle-kit.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/lifecycle-kit/issues"
  },
  "homepage": "https://github.com/jbcom/lifecycle-kit#readme",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "keywords": [
    "procedural-generation",
    "chemistry",
    "biology",
    "compositional-form",
    "pigment",
    "2.5d",
    "game-dev"
  ]
}
